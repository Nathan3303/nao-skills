# nao-orch.timer —— 定时触发 nao-orch.service（T567-B · ADR 2026-11-24 §D6）
# OnCalendar 而非 OnUnitActiveSec：Persistent= **只对日历式生效**（关机/休眠错过的 tick 要补跑）。
[Unit]
Description=nao orchestration tick timer（每 @INTERVAL@ 分钟；默认不启用）

[Timer]
OnCalendar=*:0/@INTERVAL@
Persistent=true
RandomizedDelaySec=15s
Unit=nao-orch.service

[Install]
WantedBy=timers.target
