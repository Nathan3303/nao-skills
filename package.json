{
  "name": "@nathan33/nao-skill",
  "version": "0.11.0",
  "description": "nao 多角色 AI 开发舰队：角色卡 / 技能 / 协作协议 / 工具链，一键接入项目（pi / Claude / 任意 Agent）",
  "type": "module",
  "bin": {
    "nao-skill": "bin/nao-skill.js"
  },
  "files": [
    "bin/",
    ".agents/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "agent",
    "skills",
    "multi-agent",
    "pi",
    "pi-package",
    "claude",
    "design-system",
    "codegraph"
  ],
  "pi": {
    "skills": [
      "./.agents/skills/nao-fleet/SKILL.md",
      "./.agents/skills/frontend-design/SKILL.md"
    ]
  },
  "author": "Nathan Lee",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "bash .agents/scripts/nao-fleet.sh check && npm run check:agents",
    "check:agents": "tsc -p tsconfig.agents.json",
    "prepack": "npm test"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.4.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nathan3303/nao-skills.git"
  },
  "homepage": "https://github.com/Nathan3303/nao-skills",
  "bugs": {
    "url": "https://github.com/Nathan3303/nao-skills/issues"
  }
