#!/usr/bin/env bash
# hc-double —— `hc`（herdr desktop app CLI）的**确定性替身**，只服务 T4 用例（T562/Issue #168）。
#
# 为什么需要替身：真 `hc` 连的是**用户真实桌面版 core** ⇒ 起终端会污染用户界面（arch 实测定论：
#   「真实收养 / UI 效果」不可自动化，见 docs/reports/168-arch-review.md R1）。本替身把
#   「契约面」（JSON 形状 / 标签 / doc version / 状态机）做成可断言的确定性事实；**真 hc 的
#   子集往返**另在 cases/44 用私有 core 跑（有 hc 才跑，无则 SKIP）。
#
# 契约（与实测 hc 同形，见 arch 报告）：
#   hc schema                                   → {"schema":1}
#   hc ls [--all] --json                        → {"terminals":[{address,name,cwd,state[,status]}]}
#   hc get <addr> --json                        → 单终端（labels / foreground / status / reported / parent）
#   hc run --bg [--no-parent] [--keep] --name N --cwd D --label K=V … -- <cmd…> → {"address":"tN"}
#   hc send <addr> <text>                       → {"sent":"tN"} / {"error":{…}} rc=1
#   hc kill <addr>                              → {"killed":"tN"}（幂等；state→finished）
#   hc rm <addr>                                → finished ⇒ {"removed":"tN"}；**live ⇒ error kind=live, rc=1**
#   hc connect  （stdin: JSON-RPC doc.get）      → {"result":{"value":{spaces:[…]},"version":N}}
#
# 状态根 = `$HC_DOUBLE_STATE`（**必须**由用例给；缺 ⇒ fail loud，绝不落到用户 core/%HOME% 里）。
#   调参文件（可选，均在 $HC_DOUBLE_STATE 下）：
#     docver=N         doc version（默认 10；0 ⇒ value=null）
#     doc_hide        每行一个 addr ⇒ doc 里省略（模拟「写了标签但未被收养」⇒ 验证失败分支）
#     ready=never     run 后**永不上报** status（就绪门超时分支）
#     status_app=X    默认 pi      status_state=X 默认 idle
#     run_fail=1      run 返回 error（失败分支）
#     allow_dup       允许重名（**偏离真机**：真 hc 名字 per-core 全局唯一；仅历史用例逃生阀）
#     name_taken_once 下一次 run 返回 name_taken（只一次）⇒ 复现并发竞态，验「让号重试」
#     get_order=real  `get` 的键序按**真 hc 0.1.22 实测**输（foreground 在顶层 name **之前**）——
#                     默认仍把 name 放前面（历史用例依赖「首个同名键」= 终端名）。T574/#207 用它复现
#                     「按名定位恒空」的假成功。
#     send_fail=1     send 返回 error
#     app_status_rc=N herdr-app status 的 rc（0=窗口在跑）
#     ls_fail_after_kill  设了它 ⇒ `kill` 之后建 `ls_fail_now`，此后 `ls` 一律返回 error payload + rc=1
#                     （T573 返修 D8 演练：验证「effect 复核读不到 ≠ 已消失」；找终端的那次 ls 在 kill 前 ⇒ 不受影响）
#   —— T565 (#175 放置验证失败) 的收养时序 / 陈旧 id 面 ——
#     adopt_delay=N   新建终端在 doc 里**尚未收养**：前 N 次 doc.get 只给 tab 不算终端（模拟真 app
#                     的异步收养：厂方文档「acknowledge with `pending: true`, then apply after the
#                     machine replies」）；N 用完 ⇒ 终端出现在 tab 的 root 树里（轮询可转绿）
#     adopt_never=1   同上但**永不**完成（收养超时分支）
#     stale_ids       每行一个 id（space 或 tab）。run 时若请求的 space/tab 在此名单 ⇒ app 视为
#                     「重启后已失效的 id」：忽略请求 id，落到该 cwd 的 app 自有 space（无则新建
#                     `spapp<N>` + `tbapp<N>`）。终端记的 labels = **实际** id（真 app 的行为）
#                     ⇒ 请求的 space/tab 不在 doc 里 = 复现「终端不在目标 tab 的 root 树里」
#     space_refuse=1  忽略一切放置标签（= 请求的 id 全被 app 换成自己的）：造「目标 space 永不存在」
#   契约边界：替身只模拟**观测面**（doc/labels/时序），真 app 的 UI 效果仍归人工验收。
set -uo pipefail

ST="${HC_DOUBLE_STATE:-}"
if [ -z "$ST" ]; then
  printf 'HC-DOUBLE-GUARD-FAIL: 未设 HC_DOUBLE_STATE（替身拒绝在无隔离根时运行）\n' >&2
  exit 3
fi
mkdir -p "$ST/t" "$ST/spaces" || exit 3
LOG="$ST/log"

_cfg() { # <文件名> <默认> → 文件首行或默认
  if [ -f "$ST/$1" ]; then head -1 "$ST/$1"; else printf '%s' "$2"; fi
}
_esc() { printf '%s' "${1-}" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
_addr_ok() { [ -d "$ST/t/$1" ]; }
_next_addr() {
  local n=1
  while [ -d "$ST/t/t$n" ]; do n=$((n + 1)); done
  printf 't%s' "$n"
}
_field() { head -1 "$ST/t/$1/$2" 2>/dev/null; }
_put() { printf '%s' "$3" > "$ST/t/$1/$2"; }
_log_call() { printf '%s\n' "$*" >> "$LOG"; }

# 终端 JSON（单行；键序与真 hc 无关 —— 被测脚本的抽取按「首个同名键」，见字段抽取注释）
_term_json() { # <addr>
  local a="$1" name cwd state space tab app stt rep par fgname fgargv nao_task nao_name argv_name nao_repo nao_role nao_slot
  # bare_get=1 ⇒ 只给最小字段（模拟 app 版本不支持 labels/status 契约：AC8 负控）
  # bare_labels=1 ⇒ 只缺 labels（status 仍 reported：AC8 子形态 —— 判 unknown + warn）
  if [ -f "$ST/bare_get" ]; then
    printf '{"address":"%s","name":"%s","cwd":"%s","state":"%s"}\n' \
      "$a" "$(_esc "$(_field "$a" name)")" "$(_esc "$(_field "$a" cwd)")" "$(_field "$a" state)"
    return 0
  fi
  name="$(_field "$a" name)"; cwd="$(_field "$a" cwd)"
  [ -f "$ST/t/$a/name_null" ] && name=""
  state="$(_field "$a" state)"
  space="$(_field "$a" space)"; tab="$(_field "$a" tab)"
  nao_task="$(_field "$a" nao_task)"; nao_name="$(_field "$a" nao_name)"
  nao_repo="$(_field "$a" nao_repo)"; nao_role="$(_field "$a" nao_role)"; nao_slot="$(_field "$a" nao_slot)"
  argv_name="$(_field "$a" argv_name)"; [ -n "$argv_name" ] || argv_name="$name"
  app="$(_field "$a" app)"; stt="$(_field "$a" stt)"; rep="$(_field "$a" reported)"
  par="$(_field "$a" parent)"; fgname="$(_field "$a" fg)"
  local real_order=0
  [ -f "$ST/get_order" ] && [ "$(head -1 "$ST/get_order")" = "real" ] && real_order=1
  printf '{"address":"%s","id":"%s"' "$a" "$a"
  if [ "$real_order" = "1" ]; then
    printf ',"foreground":{"name":"%s","cwd":"%s","argv":["%s","--name","%s"]}' \
      "$(_esc "${fgname:-}")" "$(_esc "$cwd")" "$(_esc "${fgname:-}")" "$(_esc "${argv_name:-}")"
  fi
  printf ',"name":"%s","cwd":"%s","state":"%s","parent":"%s"' \
    "$(_esc "$name")" "$(_esc "$cwd")" "$state" "$(_esc "$par")"
  if [ ! -f "$ST/bare_labels" ]; then
    printf ',"labels":{"herdr.space":"%s","herdr.tab":"%s"' "$(_esc "$space")" "$(_esc "$tab")"
    [ -n "$nao_name" ] && printf ',"nao.name":"%s"' "$(_esc "$nao_name")"
    [ -n "$nao_task" ] && printf ',"nao.task":"%s"' "$(_esc "$nao_task")"
    [ -n "${nao_repo:-}" ] && printf ',"nao.repo":"%s"' "$(_esc "$nao_repo")"
    [ -n "${nao_role:-}" ] && printf ',"nao.role":"%s"' "$(_esc "$nao_role")"
    [ -n "${nao_slot:-}" ] && printf ',"nao.slot":"%s"' "$(_esc "$nao_slot")"
    printf '}'
  fi
  printf ',"reported":%s' "$([ "$rep" = "1" ] && printf true || printf false)"
  if [ -n "$app" ]; then
    printf ',"status":{"app":"%s","state":"%s","state_ms":1}' "$(_esc "$app")" "$(_esc "$stt")"
  fi
  if [ "$real_order" = "1" ]; then
    printf '}\n'
  else
    printf ',"foreground":{"name":"%s","cwd":"%s","argv":["%s","--name","%s"]}}\n' \
      "$(_esc "${fgname:-}")" "$(_esc "$cwd")" "$(_esc "${fgname:-}")" "$(_esc "${argv_name:-}")"
  fi
}

cmd="${1:-}"; shift || true
_log_call "$cmd $*"

case "$cmd" in
  schema)
    printf '{"schema":1}\n' ;;

  ls)
    # T573 返修 D8 演练：kill 之后注入 ls 失败（读不到 ≠ 已消失）
    if [ -f "$ST/ls_fail_now" ]; then
      printf '{"error":{"code":"internal","message":"hc double: ls 注入失败（ls_fail_after_kill）"}}\n'
      exit 1
    fi
    all=0
    for a in "$@"; do [ "$a" = "--all" ] && all=1; done
    printf '{"terminals":['
    first=1
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      a="$(basename "$d")"
      [ "$all" = "1" ] || [ "$(_field "$a" state)" = "live" ] || continue
      [ "$first" = "1" ] || printf ','
      first=0
      printf '{"address":"%s","name":"%s","cwd":"%s","state":"%s","status":"%s"}' \
        "$a" "$(_esc "$(_field "$a" name)")" "$(_esc "$(_field "$a" cwd)")" \
        "$(_field "$a" state)" "$(_field "$a" stt)"
    done < <(find "$ST/t" -mindepth 1 -maxdepth 1 -type d | sort -V)
    printf ']}\n' ;;

  get)
    a="${1:-}"
    if ! _addr_ok "$a"; then
      printf '{"error":{"code":"not-found","message":"terminal not found: %s"}}\n' "$a" >&2
      exit 3
    fi
    _term_json "$a" ;;

  run)
    # 参数解析（只认被测脚本用到的形态；未知标志 fail loud，防替身悄悄放宽契约）
    noparent=0 keep=0 name="" cwd="" lbl_task="" lbl_name="" ; labels=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --bg) shift ;;
        --no-parent) noparent=1; shift ;;
        --keep) keep=1; shift ;;
        --name) name="${2:-}"; shift 2 ;;
        --cwd) cwd="${2:-}"; shift 2 ;;
        --label) labels+=("${2:-}"); shift 2 ;;
        --) shift; break ;;
        *) printf 'HC-DOUBLE-VIOLATION: run 未知参数 %s\n' "$1" >&2; exit 9 ;;
      esac
    done
    [ -n "$name" ] || { printf 'HC-DOUBLE-VIOLATION: run 缺 --name\n' >&2; exit 9; }
    # 与真 hc 同形：--name 限 [a-z0-9._-]{1,32}（v3 合法化后必须满足；原样传括号名 ⇒ 必红）
    case "$name" in
      *[!a-z0-9._-]*) printf '{"error":{"code":"invalid_name","message":"invalid terminal name: %s"}}\n' "$name"; exit 0 ;;
    esac
    [ "${#name}" -le 32 ] || { printf '{"error":{"code":"invalid_name","message":"terminal name too long: %s"}}\n' "$name"; exit 0; }
    # T595-A：真 hc 的名字是 **per-core 全局唯一**（厂方文档：Name, unique among live terminals）——
    #   替身按同一语义拒绝重名（只算 live）。`allow_dup` 旋钮给历史用例留逃生阀（≠ 真机行为，仅兼容）。
    # 竞态复现（T595-A）：pick 时看不见、run 时才撞 —— 只触发一次，用来验「让号重试」这条路。
    if [ -f "$ST/name_taken_once" ]; then
      rm -f "$ST/name_taken_once"
      printf '{"error":{"code":"name_taken","kind":"name_taken","message":"race: %s just taken"}}\n' "$name"
      exit 0
    fi
    if [ ! -f "$ST/allow_dup" ]; then
      _dup=""
      for _f in "$ST"/t/*/name; do
        [ -f "$_f" ] || continue
        [ "$(cat "$_f")" = "$name" ] || continue
        _a="$(basename "$(dirname "$_f")")"
        [ "$(cat "$ST/t/$_a/state" 2>/dev/null)" = "live" ] || continue
        _dup="$_a"; break
      done
      if [ -n "$_dup" ]; then
        printf '{"error":{"code":"name_taken","kind":"name_taken","message":"terminal name already in use: %s (live %s)"}}\n' "$name" "$_dup"
        exit 0
      fi
    fi
    if [ -f "$ST/run_fail" ]; then
      printf '{"error":{"code":"denied","message":"simulated run failure"}}\n'
      exit 0
    fi
    a="$(_next_addr)"
    mkdir -p "$ST/t/$a"
    _put "$a" name "$name"; _put "$a" cwd "$cwd"; _put "$a" state live
    _put "$a" space ""; _put "$a" tab ""; _put "$a" fg pi
    _put "$a" app ""; _put "$a" stt ""; _put "$a" reported 0
    # 硬护栏证据：--no-parent ⇒ parent 空；缺它且停在终端内（HC_TERMINAL_ID 有值）⇒ 记为子终端
    if [ "$noparent" = "1" ]; then _put "$a" parent ""; else _put "$a" parent "${HC_TERMINAL_ID:-}"; fi
    _put "$a" keep "$keep"
    # 放置标签（T565）：先取请求值；再按「app 是否还认得这些 id」决定实际落点。
    #   真 app 的契约（厂方内嵌文档）：标签里的 id 它认识 ⇒ 收养进该 space/tab；不认识 ⇒ 自己新建 ——
    #   **但它新建的 id 是它自己的**（本替身用 spapp<N>/tbapp<N> 代表），请求的 id 就无处可去。
    req_space=""; req_tab=""; lbl_repo=""; lbl_role=""; lbl_slot=""
    for kv in "${labels[@]:-}"; do
      [ -n "$kv" ] || continue
      k="${kv%%=*}"; v="${kv#*=}"
      case "$k" in
        herdr.space) req_space="$v" ;;
        herdr.tab)   req_tab="$v" ;;
        nao.task)    lbl_task="$v" ;;
        nao.name)    lbl_name="$v" ;;
        nao.repo)    lbl_repo="$v" ;;   # T595-B：归属（仓基键）
        nao.role)    lbl_role="$v" ;;   # T595-B：身份（角色）
        nao.slot)    lbl_slot="$v" ;;   # T595-B：身份（槽位）
        *)           printf 'HC-DOUBLE-VIOLATION: 未知 label %s\n' "$k" >&2; exit 9 ;;
      esac
    done
    [ -n "$lbl_task" ] && _put "$a" nao_task "$lbl_task"
    [ -n "$lbl_name" ] && _put "$a" nao_name "$lbl_name"
    [ -n "$lbl_repo" ] && _put "$a" nao_repo "$lbl_repo"
    [ -n "$lbl_role" ] && _put "$a" nao_role "$lbl_role"
    [ -n "$lbl_slot" ] && _put "$a" nao_slot "$lbl_slot"
    stale=0
    if [ -f "$ST/space_refuse" ]; then stale=1; fi
    if [ -f "$ST/stale_ids" ] && { [ -n "$req_space" ] || [ -n "$req_tab" ]; }; then
      [ -n "$req_space" ] && grep -qxF -- "$req_space" "$ST/stale_ids" && stale=1
      [ -n "$req_tab" ]   && grep -qxF -- "$req_tab"   "$ST/stale_ids" && stale=1
    fi
    mkdir -p "$ST/spaces"
    if [ "$stale" = "0" ]; then
      [ -z "$req_space" ] || { _put "$a" space "$req_space"; [ -f "$ST/spaces/$req_space" ] || printf '%s' "$cwd" > "$ST/spaces/$req_space"; }
      [ -z "$req_tab" ]   || _put "$a" tab "$req_tab"
    else
      # 我（app）自己的 space：该 cwd 已在某个 space ⇒ 用它；否则新开 spapp<N>（tab 同理 tbapp<N>）
      own=""
      while IFS= read -r f; do
        [ -n "$f" ] || continue
        [ "$(cat "$f")" = "$cwd" ] && { own="$(basename "$f")"; break; }
      done < <(find "$ST/spaces" -mindepth 1 -maxdepth 1 -type f | sort)
      if [ -z "$own" ]; then
        n=1; while [ -f "$ST/spaces/spapp$n" ]; do n=$((n + 1)); done
        own="spapp$n"; printf '%s' "$cwd" > "$ST/spaces/$own"
      fi
      n=1; while [ -f "$ST/tabs/tbapp$n" ]; do n=$((n + 1)); done
      mkdir -p "$ST/tabs"; : > "$ST/tabs/tbapp$n"
      _put "$a" space "$own"; _put "$a" tab "tbapp$n"
    fi
    # 异步收养（T565）：标签已写、app 还没把终端挂进 tab 的 root 树
    delay="$(_cfg adopt_delay 0)"
    if [ -f "$ST/adopt_never" ]; then _put "$a" adopt_pending -1
    elif [ "$delay" != "0" ]; then _put "$a" adopt_pending "$delay"; fi
    # 状态机：默认立即上报 pi/idle（ready=never ⇒ 永不上报）
    if [ "$(_cfg ready yes)" != "never" ]; then
      _put "$a" app "$(_cfg status_app pi)"; _put "$a" stt "$(_cfg status_state idle)"; _put "$a" reported 1
    fi
    printf '{"address":"%s"}\n' "$a" ;;

  send)
    a="${1:-}"; _addr_ok "$a" || { printf '{"error":{"code":"not-found"}}\n'; exit 1; }
    if [ -f "$ST/send_fail" ]; then printf '{"error":{"code":"rejected","message":"simulated"}}\n'; exit 1; fi
    printf '%s' "${2:-}" >> "$ST/t/$a/sent"
    printf '{"sent":"%s"}\n' "$a" ;;

  kill)
    a="${1:-}"; _addr_ok "$a" || { printf '{"error":{"code":"not-found"}}\n'; exit 1; }
    _put "$a" state finished; _put "$a" app ""; _put "$a" stt ""; _put "$a" reported 0
    [ -f "$ST/ls_fail_after_kill" ] && : > "$ST/ls_fail_now"
    printf '{"killed":"%s"}\n' "$a" ;;

  rm)
    a="${1:-}"; _addr_ok "$a" || { printf '{"error":{"code":"not-found"}}\n'; exit 1; }
    if [ "$(_field "$a" state)" = "live" ]; then
      printf '{"error":{"code":"live","message":"refusing to remove live terminal %s"}}\n' "$a"
      exit 1
    fi
    rm -rf -- "${ST:?}/t/$a"
    printf '{"removed":"%s"}\n' "$a" ;;

  connect)
    req="$(cat)"
    case "$req" in
      *'"method":"doc.get"'*) ;;
      *) printf '{"error":{"code":"unsupported","message":"hc-double only implements doc.get"}}\n'; exit 1 ;;
    esac
    ver="$(_cfg docver 10)"
    hide=""
    [ -f "$ST/doc_hide" ] && hide="$(cat "$ST/doc_hide")"
    if [ "$ver" = "0" ]; then
      printf '{"jsonrpc":"2.0","id":1,"result":{"value":null,"version":0}}\n'; exit 0
    fi
    # 异步收养计数（T565）：每次 doc.get 前把 adopt_pending 减 1（-1 = 永不完成）
    while IFS= read -r pd; do
      [ -n "$pd" ] || continue
      n="$(cat "$pd" 2>/dev/null || printf '0')"
      case "$n" in -1|0|"") : ;; *) n=$((n - 1)); printf '%s' "$n" > "$pd" ;; esac
    done < <(find "$ST/t" -mindepth 2 -maxdepth 2 -name adopt_pending 2>/dev/null | sort)
    _adopt_pending() { # <addr> → 0 已收养 / 1 还未收养（tab 已建、终端未挂进 root 树）
      local f="$ST/t/$1/adopt_pending" n
      [ -f "$f" ] || return 0
      n="$(cat "$f" 2>/dev/null || printf '0')"
      [ "$n" = "-1" ] && return 1
      [ "${n:-0}" -gt 0 ] && return 1
      return 0
    }
    printf '{"jsonrpc":"2.0","id":1,"result":{"value":{"spaces":['
    firstsp=1
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      sid="$(basename "$d")"; folder="$(cat "$d")"
      [ "$firstsp" = "1" ] || printf ','
      firstsp=0
      printf '{"id":"%s","folder":"%s","name":"%s","tabs":[' \
        "$(_esc "$sid")" "$(_esc "$folder")" "$(_esc "$(basename "$folder")")"
      firsttb=1
      while IFS= read -r td; do
        [ -n "$td" ] || continue
        ta="$(basename "$td")"
        [ "$(_field "$ta" space)" = "$sid" ] || continue
        [ "$(_field "$ta" state)" = "live" ] || continue
        case "
$hide
" in *"
$ta
"*) continue ;; esac
        tb="$(_field "$ta" tab)"
        [ -n "$tb" ] || continue
        [ "$firsttb" = "1" ] || printf ','
        firsttb=0
        # 真机形态（2026-11-25 实机）：app 的 tab 默认**没有名字**；夹具默认同样为空，
        #   仅当 `$ST/t/<addr>/tab_name` 存在时才非空（供「name 非空」变体对照）。
        _tab_name=""; [ -f "$ST/t/$ta/tab_name" ] && _tab_name="$(cat "$ST/t/$ta/tab_name" 2>/dev/null || true)"
        if _adopt_pending "$ta"; then
          printf '{"id":"%s","name":"%s","root":{"content":{"terminal":"%s"}}}' \
            "$(_esc "$tb")" "$(_esc "$_tab_name")" "$ta"
        else
          # 标签已写、app 还没把终端挂进该 tab 的 root 树（真 app 的 pending 收养）：tab 在、终端不在
          printf '{"id":"%s","name":"%s","root":{}}' \
            "$(_esc "$tb")" "$(_esc "$_tab_name")"
        fi
      done < <(find "$ST/t" -mindepth 1 -maxdepth 1 -type d | sort -V)
      printf ']}'
    done < <(find "$ST/spaces" -mindepth 1 -maxdepth 1 -type f | sort)
    printf ']},"version":%s}}\n' "$ver" ;;

  *)
    printf 'HC-DOUBLE-VIOLATION: 未实现子命令 %s\n' "${cmd:-<空>}" >&2
    exit 9 ;;
esac
