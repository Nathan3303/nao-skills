#!/usr/bin/env node
// nao-orch —— 编排器阶段 2（PRD `docs/prds/2026-11-24-orchestrator.md` §五 · ADR `2026-11-24-orch-stage2-and-script-split.md`）
//
// 子命令：
//   tick [--now <ISO>] [--queue <path>] [--root <dir>]   一次性调度（systemd timer 驱动；无常驻循环）
//   board [--json] [--now <ISO>]                        看板（数值与 queue.jsonl 同快照）
//   dispatch <任务号> [--now <ISO>]                      人工单发一条（走与 tick 完全相同的闸门/CAS/WAL）
//   reap                                                只读：WAL 里已终态/孤儿意图的点名（不做破坏性动作）
//   doctor                                              安装前体检（node/herdr/pi/git/flock · fleet status · 队列）
//   install-systemd [--interval Nm] [--session <名>] [--linger] [--enable]
//   uninstall-systemd
//
// 边界（ADR D1/D2/D5）：
//   · 唯一外部执行面 = `bin/lib/orch/fleet.mjs`（argv-only、零 shell）；状态表/校验/渲染只从 `bin/lib/queue.mjs` 取。
//   · 状态事实只在 `docs/queue.jsonl`；`docs/queue/.orch/wal.jsonl` 只记派单意图/目标/时刻。
//   · **永不**自动合并 / 发版 / 推 main（AC9：结构层白名单 + 静态闸 tests/t4/cases/47 双向）。
//
// 退出码：0 成功 · 1 契约违规 / 持锁冲突 / CAS 冲突（零写入）· 2 用法错误 · 3 环境前提不满足（不写 blocked）
import { readFileSync, existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import path from 'node:path';
import { tick, board, reap, journalLine, resolveCtx, resolveNow, isoSeconds, OrchError } from './lib/orch/tick.mjs';
import { ensureOrchDir, readLockInfo, writeLockInfo } from './lib/orch/wal.mjs';
import { flockExec } from './lib/orch/fleet.mjs';
import { doctor, installSystemd, uninstallSystemd } from './lib/orch/systemd.mjs';

const PROG = 'nao-orch';
const SELF = fileURLToPath(import.meta.url);
const LOCK_CONFLICT_RC = 42;

function fail(msg) {
  process.stderr.write(`${PROG}: ${msg}\n`);
}

function usage() {
  return [
    '用法：',
    `  ${PROG} tick [--now <ISO 时间>] [--queue <path>] [--root <dir>]`,
    `  ${PROG} board [--json] [--now <ISO 时间>]`,
    `  ${PROG} dispatch <任务号> [--now <ISO 时间>]`,
    `  ${PROG} reap`,
    `  ${PROG} doctor`,
    `  ${PROG} install-systemd [--interval Nm] [--session <名>] [--linger] [--enable]`,
    `  ${PROG} uninstall-systemd`,
    '',
    'tick 是**一次性**调度（由 systemd timer 或人工触发），无常驻进程：',
    '  · 整 tick 独占 docs/queue/.orch/lock（flock；第二实例 rc=1 并点名持锁 pid）',
    '  · 写队列前记 sha、落盘前重读比对（被人改过 ⇒ rc=1 零写入）',
    '  · 派单 = 写 WAL 意图 → ensure → 提交 row（崩在中间由下一 tick 用 WAL 的会话 id + cwd 探）',
    '  · 15m 无回执 ⇒ blocked(no_ack) + 追问一次；working 90m 且 HEAD 未变 ⇒ blocked(stalled)',
    '  · 目标角色 working/unknown ⇒ 零 ensure 只记等待；派单只认「role+task 命中且 repo=本仓」的会话（AC10）',
    '默认**不启用**（install-systemd 只落单元文件；要启用加 --enable）。',
    '',
  ].join('\n');

}

function parseOpts(argv) {
  const opts = {
    positional: [], now: '', queue: '', root: '', interval: '2', session: '',
    linger: false, enable: false, json: false, only: '',
  };
  for (let i = 0; i < argv.length; i += 1) {
    const a = argv[i];
    const need = () => {
      if (i + 1 >= argv.length) throw new OrchError(`${a} 缺少参数值`);
      i += 1;
      return argv[i];
    };
    if (a === '--now') opts.now = need();
    else if (a === '--queue') opts.queue = need();
    else if (a === '--root') opts.root = need();
    else if (a === '--interval') opts.interval = String(need()).replace(/m$/, '');
    else if (a === '--session') opts.session = need();
    else if (a === '--linger') opts.linger = true;
    else if (a === '--enable') opts.enable = true;
    else if (a === '--json') opts.json = true;
    else if (a === '--only-id') opts.only = need();
    else if (a === '-h' || a === '--help') opts.help = true;
    else if (a.startsWith('-')) throw new OrchError(`未知选项：${a}`);
    else opts.positional.push(a);
  }
  return opts;
}

function printTickResult(res, ctx, opts) {
  if (res.errors) {
    for (const e of res.errors) process.stderr.write(`${PROG}: ${e}\n`);
    process.stderr.write(`${PROG}: 队列校验未过（${res.errors.length} 项）⇒ 本 tick 零写入\n`);
  } else if (res.why) {
    fail(res.why);
  }
  if (res.render && res.render.rendered === false) {
    process.stderr.write(`${PROG}: NOTICE tasks-state 未重渲染（${res.render.why}）\n`);
  }
  const nowMs = opts.now ? Date.parse(opts.now) : Date.now();
  process.stdout.write(`${journalLine(ctx, isoSeconds(nowMs), res.counters, res.rc)}\n`);
}

// tick 的锁外壳：**整 tick 一把、每仓一把**（D4）。锁由内核附着 fd 持有 ⇒ 进程退出即释放，无 stale 锁。
function runTickLocked(argv) {
  const opts = parseOpts(argv);
  const ctx = resolveCtx({ root: opts.root, queue: opts.queue });
  ensureOrchDir(ctx.root);
  if (process.env.NAO_ORCH_LOCK_HELD === '1') {
    writeLockInfo(ctx.lock, process.pid, new Date().toISOString());
    return { rc: tickAndReport(opts, ctx) };
  }
  const r = flockExec(['-n', '-E', String(LOCK_CONFLICT_RC), ctx.lock, process.execPath, SELF, 'tick', ...argv], {
    stdio: 'inherit',
    // 内层由**同一次** flock 持有锁（再进锁外壳会自我冲突）⇒ 显式标记「已持锁」
    env: { ...process.env, NAO_ORCH_LOCK_HELD: '1' },
  });
  if (r.rc === LOCK_CONFLICT_RC) {
    const info = readLockInfo(ctx.lock);
    fail(
      info
        ? `另一个 orch tick 正在运行（持锁 pid=${info.pid} started=${info.started}）⇒ 本实例不执行（rc=1）`
        : '另一个 orch tick 正在运行（锁文件暂无持锁人信息）⇒ 本实例不执行（rc=1）',
    );
    return { rc: 1 };
  }
  return { rc: r.rc };
}

function tickAndReport(opts, ctx) {
  let res;
  try {
    res = tick({ root: opts.root, queue: opts.queue, now: opts.now, only: opts.only || undefined });
  } catch (e) {
    if (e instanceof OrchError) {
      fail(e.message);
      return 2;
    }
    throw e;
  }
  printTickResult(res, ctx, opts);
  return res.rc;
}

function ageText(t) {
  return Number.isFinite(t.age_min) ? `${t.age_min}m` : '?';
}

// AC11 看板：数据源 = queue.jsonl（**一次运行只读一次**，同 tick 快照）+ `docs/queue/*.receipt.json`。
//   禁落盘、禁缓存 —— 本函数与 tick.mjs::board 都不写任何文件（第二事实源 = 违规）。
function cmdBoard(opts) {
  const res = board({ root: opts.root, queue: opts.queue, now: opts.now });
  if (res.rc !== 0) {
    for (const e of res.errors) fail(e);
    return 1;
  }
  if (opts.json) {
    process.stdout.write(`${JSON.stringify({
      schema: 1,
      tick_at: res.tickAt,
      repo: res.ctx.root,
      digits: res.digits,
      tasks: res.tasks,
      receipts: res.receipts,
      wal_bad_lines: res.walBad.length,
    })}\n`);
    return 0;
  }
  const digitText = Object.entries(res.digits).map(([k, v]) => `${k}=${v}`).join(' ');
  process.stdout.write(`orch board repo=${path.basename(res.ctx.root)} tick_at=${res.tickAt} tasks=${res.tasks.length} receipts=${res.receipts.total}\n`);
  process.stdout.write(`  分区 ${digitText}\n`);
  const blocked = res.tasks.filter((t) => t.state === 'blocked');
  process.stdout.write(`  阻塞 ${blocked.length}：\n`);
  for (const t of blocked) {
    process.stdout.write(`    · ${t.id} owner=${t.owner || '-'} attempt=${t.attempt} age=${ageText(t)} reason=${t.blocked_reason || '-'}\n`);
  }
  const inflightStates = new Set(['dispatched', 'working', 'qa', 'qa_fail', 'merging']);
  const inflight = res.tasks.filter((t) => inflightStates.has(t.state));
  process.stdout.write(`  在飞 ${inflight.length}：\n`);
  for (const t of inflight) {
    process.stdout.write(`    · ${t.id} ${t.state} owner=${t.owner || '-'} prio=${t.prio} attempt=${t.attempt} age=${ageText(t)}${t.wal ? ` wal=${t.wal}` : ''}\n`);
  }
  const latest = res.receipts.latest.slice(0, 5);
  process.stdout.write(`  回执 ${res.receipts.total}（最近 ${latest.length}）：\n`);
  for (const r of latest) {
    const gates = `check:${r.gates.check === null ? '?' : r.gates.check},full:${r.gates.full === null ? '?' : r.gates.full}`;
    process.stdout.write(`    · ${r.id} author=${r.author || '-'} at=${r.at || '-'} gates=${gates} acs=${r.acs} head=${String(r.head || '').slice(0, 7) || '-'}\n`);
  }
  if (res.receipts.unreadable) process.stdout.write(`  ! 回执有 ${res.receipts.unreadable} 个不可解析（board 只计数；判红归 nao-queue validate）\n`);
  if (res.walBad.length) process.stdout.write(`  ! WAL 有 ${res.walBad.length} 行不可解析（append-only 崩溃尾部，已跳过）\n`);
  return 0;
}

function cmdReap(opts) {
  const res = reap({ root: opts.root, queue: opts.queue });
  if (res.rc !== 0) {
    for (const e of res.errors) fail(e);
    return 1;
  }
  process.stdout.write(`orch reap wal_records=${res.records} stale=${res.reapable.length}\n`);
  for (const x of res.reapable) process.stdout.write(`  · ${x.id}：${x.why}（key=${x.key || '-'}）\n`);
  if (res.walBad.length) process.stdout.write(`  ! WAL 有 ${res.walBad.length} 行不可解析\n`);
  return 0;
}

function cmdDoctor(opts) {
  const res = doctor({ root: opts.root, queue: opts.queue });
  for (const l of res.lines) process.stdout.write(`${l}\n`);
  process.stdout.write(`orch doctor: ${res.ok ? 'ok' : 'fail'}（node/herdr/pi/git/flock · repo · queue · fleet · status-json）\n`);
  return res.ok ? 0 : 3;
}

function cmdInstall(opts) {
  const res = installSystemd({ root: opts.root, queue: opts.queue, interval: opts.interval, session: opts.session, linger: opts.linger, enable: opts.enable });
  if (res.doctor) for (const l of res.doctor.lines) process.stdout.write(`${l}\n`);
  if (res.rc !== 0) {
    fail(res.why);
    return res.rc;
  }
  process.stdout.write(`orch install-systemd: ok units=${res.units} changed=${res.changed} reloaded=${res.reloaded ? 'yes' : 'no'} enabled=${res.enabled ? 'yes' : 'no'}（默认不启用；加 --enable 才 enable）\n`);
  return 0;
}

function cmdUninstall() {
  const res = uninstallSystemd();
  if (res.rc !== 0) {
    fail('uninstall-systemd 失败');
    return res.rc;
  }
  process.stdout.write(`orch uninstall-systemd: ok units=${res.units} removed=${res.removed}${res.note ? `（${res.note}）` : ''}\n`);
  return 0;
}

function main() {
  const argv = process.argv.slice(2);
  const cmd = argv[0];
  if (!cmd || cmd === '-h' || cmd === '--help') {
    process.stdout.write(usage());
    return cmd ? 0 : 2;
  }
  try {
    if (cmd === 'tick') return runTickLocked(argv.slice(1)).rc;
    const opts = parseOpts(argv.slice(1));
    if (opts.help) {
      process.stdout.write(usage());
      return 0;
    }
    switch (cmd) {
      case 'board': return cmdBoard(opts);
      case 'dispatch': {
        const id = opts.positional[0];
        if (!id) {
          fail('dispatch 需要任务号（如 dispatch T567）');
          return 2;
        }
        return runTickLocked([...argv.slice(1), '--only-id', id]).rc;
      }
      case 'reap': return cmdReap(opts);
      case 'doctor': return cmdDoctor(opts);
      case 'install-systemd': return cmdInstall(opts);
      case 'uninstall-systemd': return cmdUninstall();
      default:
        fail(`未知子命令：${cmd}\n${usage()}`);
        return 2;
    }
  } catch (e) {
    if (e instanceof OrchError) {
      fail(e.message);
      return 2;
    }
    throw e;
  }
}

process.exit(main());
