#!/usr/bin/env node
// nao-queue —— 编排器阶段 1（PRD `docs/prds/2026-11-24-orchestrator.md` §四）
//
// 契约（单向，唯一事实源 = `docs/queue.jsonl`）：
//   render   docs/queue.jsonl → docs/tasks-state.md 的「进行中 / 待派发」两区（渲染产物带 `<!-- generated -->`，禁手改）
//   validate 队列行 schema + 状态机 + 回执 schema（`docs/queue/<id>.receipt.json`）+ `pushed:true` 的远端复核
//   transition  纯判定一条状态转换是否合法（不写文件；阶段 2 的 tick 复用同一张表）
//   receipt-line  由回执 JSON 生成机读首行 `receipt: <id> <role> head=<sha> gates=<ok|red>,<ok|red> acs=<n>/<n>`
//
// 零依赖 / 零网络：只有 `pushed:true` 会显式调用 `git ls-remote`（可用 `--no-push-check` 显式跳过，跳过必打 NOTICE）。
// 退出码：0 = 通过 · 1 = 契约违规 / 非法转换 · 2 = 用法错误（缺命令、缺标记、文件不存在等）。
import { readFileSync, writeFileSync, existsSync, readdirSync } from 'node:fs';
import path from 'node:path';

const PROG = 'nao-queue';
const DEFAULT_QUEUE = 'docs/queue.jsonl';
const DEFAULT_TARGET = 'docs/tasks-state.md';
const DEFAULT_RECEIPTS = 'docs/queue';

import {
  STATES, TRANSITIONS, REGION_STATES, MARKER_BEGIN, MARKER_END, GENERATED_HEAD,
  QUEUE_FIELDS, RECEIPT_FIELDS, DATE_RE, SHA_RE, UsageError,
  readText, isPlainObject, typeOf, short, nonEmptyString,
  parseQueue, validateQueue, renderRegion, spliceRegion, firstDiffLines,
  checkReceipt,
} from './lib/queue.mjs';

// ---------------------------------------------------------------- 小工具

function fail(lines) {
  const list = Array.isArray(lines) ? lines : [lines];
  for (const l of list) process.stderr.write(`${PROG}: ${l}\n`);
  process.exit(1);
}

// ---------------------------------------------------------------- 命令

function parseArgs(argv) {
  const opts = {
    queue: DEFAULT_QUEUE, target: DEFAULT_TARGET, receipts: DEFAULT_RECEIPTS,
    remote: 'origin', check: false, stdout: false, noPushCheck: false, from: '', to: '', id: '',
  };
  const positional = [];
  for (let i = 0; i < argv.length; i += 1) {
    const a = argv[i];
    const take = (name) => {
      if (i + 1 >= argv.length) throw new UsageError(`${name} 缺少参数值`);
      i += 1;
      return argv[i];
    };
    if (a === '--queue') opts.queue = take(a);
    else if (a === '--target') opts.target = take(a);
    else if (a === '--receipts') opts.receipts = take(a);
    else if (a === '--remote') opts.remote = take(a);
    else if (a === '--from') opts.from = take(a);
    else if (a === '--to') opts.to = take(a);
    else if (a === '--check') opts.check = true;
    else if (a === '--stdout') opts.stdout = true;
    else if (a === '--no-push-check') opts.noPushCheck = true;
    else if (a === '--id') opts.id = take(a);
    else if (a === '-h' || a === '--help') opts.help = true;
    else if (a.startsWith('-')) throw new UsageError(`未知选项：${a}`);
    else positional.push(a);
  }
  return { opts, positional };
}

function loadQueueOrDie(opts) {
  const { rows, errors: parseErrors } = parseQueue(opts.queue);
  const { errors, byId } = validateQueue(opts.queue, rows, parseErrors);
  if (errors.length) fail([...errors, `队列校验未过（${errors.length} 项）⇒ 拒绝继续（不渲染、不放过回执）`]);
  return { rows, byId };
}

function cmdRender(opts) {
  const { rows } = loadQueueOrDie(opts);
  let text = readText(opts.target, '渲染目标');
  if (!text.endsWith('\n')) text += '\n';
  let next = spliceRegion(text, 'active', renderRegion('active', rows), opts.target);
  next = spliceRegion(next, 'dispatch', renderRegion('dispatch', rows), opts.target);
  if (opts.stdout) {
    // 只打印两个生成区（不落盘），供 diff / 评审直接看
    process.stdout.write(`--- active ---\n${renderRegion('active', rows)}\n--- dispatch ---\n${renderRegion('dispatch', rows)}\n`);
    return 0;
  }
  const changed = next !== text;
  if (opts.check) {
    if (!changed) {
      process.stdout.write(`OK: ${opts.target} 与 ${opts.queue} 的渲染结果一致\n`);
      return 0;
    }
    process.stderr.write(`${PROG}: ${opts.target} 与渲染结果不一致（手改会被覆盖；判据见 AC4）\n`);
    for (const l of firstDiffLines(text, next)) process.stderr.write(`${l}\n`);
    return 1;
  }
  if (changed) writeFileSync(opts.target, next);
  process.stdout.write(`${changed ? 'OK: 已渲染' : 'OK: 无变化（幂等）'} ${opts.queue} → ${opts.target}（${rows.length} 行）\n`);
  return 0;
}

function cmdValidate(opts) {
  const { byId } = loadQueueOrDie(opts);
  const errors = [];
  let receipts = 0;
  if (existsSync(opts.receipts)) {
    const files = readdirSync(opts.receipts).filter((f) => f.endsWith('.receipt.json')).sort();
    for (const f of files) {
      const full = path.join(opts.receipts, f);
      let obj;
      try {
        obj = JSON.parse(readFileSync(full, 'utf8'));
      } catch (e) {
        errors.push(`${full}: 不是合法 JSON（${e.message}）`);
        continue;
      }
      receipts += 1;
      errors.push(...checkReceipt(obj, full, byId, opts));
    }
  } else {
    process.stderr.write(`${PROG}: NOTICE 回执目录不存在（${opts.receipts}）⇒ 本次只校验队列，没有回执可校验\n`);
  }
  if (opts.noPushCheck) {
    process.stderr.write(`${PROG}: NOTICE --no-push-check ⇒ 已跳过 pushed:true 的 git ls-remote 复核（AC2 未验）\n`);
  }
  if (errors.length) fail([...errors, `契约校验未过（${errors.length} 项）`]);
  process.stdout.write(`OK: queue=${opts.queue}（${byId.size} 行）· receipts=${receipts} 份 · push 复核=${opts.noPushCheck ? 'skipped' : `on(${opts.remote})`}\n`);
  return 0;
}

function cmdTransition(opts) {
  const { from, to } = opts;
  if (!from || !to) throw new UsageError('transition 需要 --from <状态> 与 --to <状态>');
  for (const [name, v] of [['--from', from], ['--to', to]]) {
    if (!STATES.includes(v)) throw new UsageError(`${name} 取值非法：${v}（合法值 ${STATES.join('/')}）`);
  }
  // 同态自转同样非法，回显口径与其它非法转换一致（都给出允许集，P3-1）
  if (from === to) {
    const allowedSame = TRANSITIONS[from] || [];
    process.stderr.write(`${PROG}: 非法状态转换 ${from} → ${to}（同一状态不是转换；从 ${from} 允许：${allowedSame.length ? allowedSame.join('/') : '无（终态）'}）\n`);
    return 1;
  }
  const allowed = TRANSITIONS[from] || [];
  if (!allowed.includes(to)) {
    process.stderr.write(`${PROG}: 非法状态转换 ${from} → ${to}（从 ${from} 允许：${allowed.length ? allowed.join('/') : '无（终态）'}）\n`);
    return 1;
  }
  process.stdout.write(`OK: ${from} → ${to}\n`);
  return 0;
}

function cmdTransitions() {
  for (const s of STATES) {
    const next = TRANSITIONS[s] || [];
    process.stdout.write(`${s} → ${next.length ? next.join(' | ') : '（终态）'}\n`);
  }
  return 0;
}

function cmdReceiptLine(opts, positional) {
  // 不内置默认回执（P3-3）：路径由位置参数给出，或由 --id 拼 `--receipts/<id>.receipt.json`；两者皆缺 ⇒ fail loud。
  let file = positional[0];
  if (!file) {
    if (!opts.id) {
      throw new UsageError('receipt-line 需要回执文件路径或 --id <任务号>（不再内置默认回执）');
    }
    file = path.join(opts.receipts, `${opts.id}.receipt.json`);
  }
  let obj;
  try {
    obj = JSON.parse(readText(file, '回执文件'));
  } catch (e) {
    if (e instanceof UsageError) throw e;
    throw new UsageError(`回执文件无法解析：${file}（${e.message}）`);
  }
  const { byId } = loadQueueOrDie(opts);
  const errors = checkReceipt(obj, file, byId, opts);
  // P2-1：机读首行的语义 =「已交付且可复核」⇒ pushed 必须是 true（缺字段已由 schema 报红）。
  // 不得因为 pushed:false/缺失就静默跳过校验后照样出机读行。
  if (isPlainObject(obj)) {
    if (obj.pushed !== true) {
      errors.push(`${file}: receipt-line 要求 pushed:true（实际 ${short(obj.pushed)}）—— 未推送的回执拒绝出机读首行`);
    }
    if (opts.id && obj.id !== opts.id) {
      errors.push(`${file}: --id=${opts.id} 与回执 id=${short(obj.id)} 不一致`);
    }
  }
  if (errors.length) fail([...errors, '回执校验未过 ⇒ 不生成机读首行']);
  if (opts.noPushCheck) {
    process.stderr.write(`${PROG}: NOTICE --no-push-check ⇒ 已跳过 pushed:true 的 git ls-remote 复核（机读首行基于回执自述）\n`);
  }
  const rc = (g) => (obj.gates[g].rc === 0 ? 'ok' : 'red');
  const row = byId.get(obj.id);
  const total = Array.isArray(row.acs) ? row.acs.length : 0;
  process.stdout.write(`receipt: ${obj.id} ${obj.author} head=${obj.head} gates=${rc('check')},${rc('full')} acs=${obj.acs.length}/${total}\n`);
  return 0;
}

function usage() {
  return `用法：
  ${PROG} render      [--queue ${DEFAULT_QUEUE}] [--target ${DEFAULT_TARGET}] [--check | --stdout]
  ${PROG} validate    [--queue ${DEFAULT_QUEUE}] [--receipts ${DEFAULT_RECEIPTS}] [--remote origin] [--no-push-check]
  ${PROG} transition  --from <状态> --to <状态>
  ${PROG} transitions
  ${PROG} receipt-line (<回执.json> | --id <任务号>) [--queue ...] [--receipts ...] [--remote origin] [--no-push-check]

render 只读 ${DEFAULT_QUEUE}，写 ${DEFAULT_TARGET} 里 <!-- nao-queue:begin|end active|dispatch --> 两个标记区；
--check 只判「当前文件 == 渲染结果」（rc=1 = 被手改过）。标记缺失/重复 ⇒ rc=2，不静默追加。
`;
}

function main() {
  let parsed;
  try {
    parsed = parseArgs(process.argv.slice(2));
  } catch (e) {
    process.stderr.write(`${PROG}: ${e.message}\n${usage()}`);
    return 2;
  }
  const { opts, positional } = parsed;
  const cmd = positional[0];
  if (opts.help || !cmd) {
    process.stdout.write(usage());
    return opts.help ? 0 : 2;
  }
  if (positional.length > 2 || (positional.length === 2 && cmd !== 'receipt-line')) {
    process.stderr.write(`${PROG}: 多余的参数：${positional.slice(1).join(' ')}\n${usage()}`);
    return 2;
  }
  try {
    switch (cmd) {
      case 'render': return cmdRender(opts);
      case 'validate': return cmdValidate(opts);
      case 'transition': return cmdTransition(opts);
      case 'transitions': return cmdTransitions();
      case 'receipt-line': return cmdReceiptLine(opts, positional.slice(1));
      default:
        process.stderr.write(`${PROG}: 未知命令 ${cmd}\n${usage()}`);
        return 2;
    }
  } catch (e) {
    if (e instanceof UsageError) {
      process.stderr.write(`${PROG}: ${e.message}\n`);
      return 2;
    }
    throw e;
  }
}

process.exit(main());
